# GAP #1 — Tạo downstream RKE2 cluster qua provisioning.cattle.io/v1 (kubectl apply lên
# LOCAL cluster của Rancher), thay vì REST /v3/cluster. Lý do: idempotent + ổn định hơn,
# Rancher tự sinh clusterregistrationtoken để lấy lệnh join.
#
# ⚠️ REVIEW: phần này CHƯA chạy tay lần nào (cluster cũ tạo qua UI). Cần test kỹ:
#   - kubernetesVersion phải khớp version RKE2 Rancher hỗ trợ ({{ rke2_version }})
#   - sau apply, đọc: kubectl get clusterregistrationtoken -n fleet-default -o ...
apiVersion: provisioning.cattle.io/v1
kind: Cluster
metadata:
  name: {{ cluster_name }}
  namespace: fleet-default
spec:
  kubernetesVersion: {{ rke2_version }}
  rkeConfig:
    machineGlobalConfig:
      cni: calico
      disable-kube-proxy: false
      etcd-expose-metrics: false
    # Manifest Calico/CoreDNS được đặt thủ công vào /var/lib/rancher/rke2/server/manifests/
    # ở play 06 TRƯỚC khi node join — không cấu hình addon ở đây để tránh trùng.
  localClusterAuthEndpoint: {}
