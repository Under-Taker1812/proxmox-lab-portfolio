# Creates a downstream RKE2 cluster via provisioning.cattle.io/v1 (kubectl apply against Rancher's
# LOCAL cluster), instead of the REST /v3/cluster endpoint. Reason: more idempotent and stable —
# Rancher generates its own clusterregistrationtoken for the join command from this.
#
# ⚠️ REVIEW: this path has never been hand-verified end to end (existing clusters were created
#   through the UI). Needs testing:
#   - kubernetesVersion must match an RKE2 version Rancher actually supports ({{ rke2_version }})
#   - after apply, check: kubectl get clusterregistrationtoken -n fleet-default -o ...
apiVersion: provisioning.cattle.io/v1
kind: Cluster
metadata:
  name: {{ cluster_name }}
  namespace: fleet-default
spec:
  kubernetesVersion: {{ rke2_version }}
  rkeConfig:
    machineGlobalConfig:
      cni: calico
      disable-kube-proxy: false
      etcd-expose-metrics: false
    # The Calico/CoreDNS manifests are staged manually into
    # /var/lib/rancher/rke2/server/manifests/ by play 06, before the node joins — no addon config
    # here, to avoid a duplicate/conflicting configuration.
  localClusterAuthEndpoint: {}
