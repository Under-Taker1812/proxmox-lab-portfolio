# A dedicated netplan file for NIC2 (storage VLAN), so cloud-init never overwrites it.
# The interface name is auto-detected (never hardcoded) — passed in via the storage_iface variable.
# chmod 600 after rendering (netplan warns on world-readable files).
network:
  version: 2
  ethernets:
    {{ storage_iface }}:
      dhcp4: false
      addresses:
        - {{ storage_ip }}/{{ storage_ip_pool.netmask_cidr }}
