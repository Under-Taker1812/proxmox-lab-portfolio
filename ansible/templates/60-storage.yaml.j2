# Bug #7 — netplan file RIÊNG cho NIC2 (VLAN 109), tránh bị cloud-init overwrite.
# Interface name auto-detect (KHÔNG hardcode ens19) — truyền qua biến storage_iface.
# chmod 600 sau khi render (netplan cảnh báo world-readable).
network:
  version: 2
  ethernets:
    {{ storage_iface }}:
      dhcp4: false
      addresses:
        - {{ storage_ip }}/{{ storage_ip_pool.netmask_cidr }}
