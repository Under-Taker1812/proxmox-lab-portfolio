# ceph-csi-rbd Helm values — encodes the hostNetwork fix, the port 8681 fix, and the dynamic
# replicaCount fix. monitors = the storage VLAN's Ceph MONs on port 3300. The Secret/StorageClass
# are created separately (see csi-rbd-secret.yaml.j2 / csi-rbd-storageclass.yaml.j2).
#
# replicaCount used to be hardcoded to 2 (correct back when the default cluster had 2 workers), but
# once the default cluster shrank to 1 worker, nobody updated it — the second replica got stuck
# Pending forever (the CP is tainted, and the one worker already held hostPort 8681). Now computed
# DYNAMICALLY from the real worker count for this run (playbooks/08-ceph-csi.yml, the
# ceph_csi_provisioner_replicas variable).
csiConfig:
  - clusterID: "{{ ceph_fsid }}"
    monitors:
{% for mon in ceph_mon_endpoints %}
      - "{{ mon }}"
{% endfor %}

secret:
  create: false
storageClass:
  create: false

provisioner:
  replicaCount: {{ ceph_csi_provisioner_replicas }}   # matches the real schedulable worker count dynamically (CPs are tainted)
  enableHostNetwork: true         # without this the provisioner uses its pod IP, which Ceph can't route a reply to
  httpMetrics:
    containerPort: 8681           # the node-plugin already holds 8080 — changed to avoid a conflict under hostNetwork

cephconf: |
  [global]
    auth_cluster_required = cephx
    auth_service_required = cephx
    auth_client_required = cephx
    public_network = {{ ceph_public_network }}
