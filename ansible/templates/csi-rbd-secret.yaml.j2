# The keyring Secret for ceph-csi. userKey is read DIRECTLY from `ceph auth get-key` (avoids l/I transcription typos).
apiVersion: v1
kind: Secret
metadata:
  name: csi-rbd-secret
  namespace: ceph-csi-rbd
type: Opaque
stringData:
  userID: "{{ ceph_csi_user }}"
  userKey: "{{ ceph_csi_user_key }}"
