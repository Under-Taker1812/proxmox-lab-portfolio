# Fluent Bit Helm values (chart fluent/fluent-bit) — a DaemonSet collecting every pod's logs,
# forwarding straight to the data-collector hub's Elasticsearch (no local ES/Kibana/fluentd).
#
# A cluster_name={{ cluster_name }} field is attached to every record via record_modifier — fixed
# at deploy time, so it's templated directly through Ansible (same pattern as vmagent), no runtime
# ConfigMap/env var needed.
#
# Carries forward two fixes found while an earlier ClusterOutput/banzaicloud-based setup was in use
# (now applied directly to Fluent Bit's own ES output plugin):
#   - ssl_verify false, since Elasticsearch 8.x uses a self-signed cert         → tls.verify Off
#   - suppress_type_name true, ILM disabled in favor of logstash-style indices → Suppress_Type_Name On, Logstash_Format On

resources:
  requests:
    memory: {{ hub_agent_values.fluent_bit_mem_request }}
  limits:
    memory: {{ hub_agent_values.fluent_bit_mem_limit }}

config:
  service: |
    [SERVICE]
        Flush         5
        Log_Level     info
        Parsers_File  parsers.conf
        # The HTTP server on port 2020 MUST stay enabled when overriding config.service — without
        # it, the chart's default readinessProbe (httpGet /api/v1/health on port 2020) gets
        # connection refused, and the pod sits at 0/1 Ready forever even though Fluent Bit itself is
        # running fine.
        HTTP_Server   On
        HTTP_Listen   0.0.0.0
        HTTP_Port     2020

  inputs: |
    [INPUT]
        Name              tail
        Path              /var/log/containers/*.log
        Parser            docker
        Tag               kube.*
        Mem_Buf_Limit     10MB
        Skip_Long_Lines  On

  filters: |
    [FILTER]
        Name                kubernetes
        Match               kube.*
        Kube_URL            https://kubernetes.default.svc:443
        Merge_Log           On
        K8S-Logging.Parser  On

    [FILTER]
        Name    record_modifier
        Match   *
        Record  cluster_name {{ cluster_name }}

  outputs: |
    [OUTPUT]
        Name                es
        Match               *
        Host                {{ hub_host }}
        Port                {{ hub_logs_port }}
        HTTP_User           {{ hub_es_user }}
        HTTP_Passwd         {{ hub_es_password }}
        tls                 On
        tls.verify          {{ 'On' if hub_logs_tls_verify else 'Off' }}
        Suppress_Type_Name  On
        Logstash_Format     On
        Logstash_Prefix     k8s-{{ cluster_name }}
        Retry_Limit         False
        # Trace_Error: without it, a chunk partially rejected by ES (e.g. a mapping conflict) only
        # logs a generic "failed to flush chunk" and retries the ENTIRE chunk forever — it can never
        # self-resolve because the failure is in the data, not the connection. Enabling this prints
        # the real JSON error from ES (the specific field/reason) directly in the pod's logs, which
        # is what makes a permanently-stuck chunk diagnosable at all.
        Trace_Error         On
