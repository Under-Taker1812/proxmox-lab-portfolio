# Fluent Bit Helm values (chart fluent/fluent-bit) — DaemonSet thu log mọi pod, forward thẳng
# về Elasticsearch của data-collector-hub (KHÔNG cài ES/Kibana/fluentd local nữa).
#
# Field cluster_name={{ cluster_name }} gắn vào mọi record bằng record_modifier — cố định lúc
# deploy nên template thẳng qua Ansible (giống vmagent), không cần ConfigMap/env var runtime.
#
# Encode lại 2 bug đã tìm ra hồi còn dùng ClusterOutput/banzaicloud (nay áp trực tiếp vào ES
# output plugin của Fluent Bit):
#   Bug #9  — ssl_verify false (ES 8.x self-signed cert)       → tls.verify Off
#   Bug #10 — suppress_type_name true, tắt ilm dùng logstash    → Suppress_Type_Name On, Logstash_Format On

resources:
  requests:
    memory: {{ hub_agent_values.fluent_bit_mem_request }}
  limits:
    memory: {{ hub_agent_values.fluent_bit_mem_limit }}

config:
  service: |
    [SERVICE]
        Flush         5
        Log_Level     info
        Parsers_File  parsers.conf
        # HTTP server cổng 2020 — BẮT BUỘC giữ khi override config.service, nếu không
        # readinessProbe mặc định của chart (httpGet /api/v1/health cổng 2020) bị connection
        # refused → pod mãi 0/1 Ready dù Fluent Bit vẫn chạy (bug phát hiện 2026-07-30, verify [11]).
        HTTP_Server   On
        HTTP_Listen   0.0.0.0
        HTTP_Port     2020

  inputs: |
    [INPUT]
        Name              tail
        Path              /var/log/containers/*.log
        Parser            docker
        Tag               kube.*
        Mem_Buf_Limit     10MB
        Skip_Long_Lines  On

  filters: |
    [FILTER]
        Name                kubernetes
        Match               kube.*
        Kube_URL            https://kubernetes.default.svc:443
        Merge_Log           On
        K8S-Logging.Parser  On

    [FILTER]
        Name    record_modifier
        Match   *
        Record  cluster_name {{ cluster_name }}

  outputs: |
    [OUTPUT]
        Name                es
        Match               *
        Host                {{ hub_host }}
        Port                {{ hub_logs_port }}
        HTTP_User           {{ hub_es_user }}
        HTTP_Passwd         {{ hub_es_password }}
        tls                 On
        tls.verify          {{ 'On' if hub_logs_tls_verify else 'Off' }}
        Suppress_Type_Name  On
        Logstash_Format     On
        Logstash_Prefix     k8s-{{ cluster_name }}
        Retry_Limit         False
        # Trace_Error (thêm 2026-08-18): mặc định chunk bị ES từ chối một phần (vd mapping conflict)
        # chỉ log "failed to flush chunk" chung chung rồi retry NGUYÊN CẢ chunk mãi mãi — không bao
        # giờ tự sửa được vì lỗi nằm ở dữ liệu, không phải kết nối. Bật để in ra JSON lỗi thật từ ES
        # (field/reason cụ thể) ngay trong log pod, phục vụ chẩn đoán các chunk kẹt vĩnh viễn.
        Trace_Error         On
