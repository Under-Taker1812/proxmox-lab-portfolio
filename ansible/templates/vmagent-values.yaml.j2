# vmagent Helm values (chart victoria-metrics-agent) — remote_write to the data-collector hub, with
# a cluster={{ cluster_name }} label attached RIGHT AT THE POINT OF SENDING (not on the receiving
# end), so every metric (including from any scrape target added later) automatically carries a
# label identifying its source cluster.
#
# ⚠️ REVIEW: the `remoteWrite`/`extraArgs` fields below follow the victoria-metrics-agent chart's
# publicly documented values.yaml at the time this was written — not yet hand-verified against the
# actual pinned chart version. Before the first real run: `helm show values vm/victoria-metrics-agent
# | less` and cross-check the field names, the same way the REVIEW note in
# playbooks/07-join-cluster.yml was handled.
remoteWrite:
  - url: "{{ hub_metrics_remote_write_url }}"

extraArgs:
  remoteWrite.label: "cluster={{ cluster_name }}"

resources:
  requests:
    memory: {{ hub_agent_values.vmagent_mem_request }}
  limits:
    memory: {{ hub_agent_values.vmagent_mem_limit }}
