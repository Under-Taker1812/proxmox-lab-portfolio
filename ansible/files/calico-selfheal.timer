[Unit]
Description=Runs calico-selfheal periodically (and right after boot — since boot is when the bug occurs)

[Timer]
# Boot is exactly when this bug occurs (RKE2 re-runs helm-install-rke2-calico
# → recreates the Installation CR → the namespace gets garbage-collected → the webhook blocks recreating it).
# 150s after boot is enough for rke2-server + the apiserver to be ready; if not, the script
# exits silently and the next periodic run picks it up.
OnBootSec=150s

# Uses OnCalendar rather than just OnUnitActiveSec — this is DELIBERATE:
# OnUnitActiveSec schedules its next run relative to the service's OWN last run. If the service
# has never run yet and the OnBootSec point has already passed (e.g. the timer gets enabled
# hours after boot), systemd has nothing to schedule from → `Trigger: n/a` → the timer never
# fires again. OnCalendar always has a real next-fire time, so it never falls into that trap.
OnCalendar=*:0/3
AccuracySec=15s
RandomizedDelaySec=10s
Unit=calico-selfheal.service

[Install]
WantedBy=timers.target
