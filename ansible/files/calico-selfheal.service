[Unit]
Description=Tự phát hiện + tự gỡ deadlock Calico bị rancher-webhook chặn
Documentation=file:///root/rke2-calico-netfilter-bugs.md
After=rke2-server.service
Wants=rke2-server.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/calico-selfheal.sh
# Script tự thoát 0 khi cụm lành; exit 1 nghĩa là đã thử sửa mà không xong
# hoặc đã vượt trần rate limit → xem journalctl -t calico-selfheal
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
