# deploy-config.yml — one file bundling every choice needed to run site.yml/cleanup.yml, instead of
# typing out a long "-e cluster_name=... mode=... rancher_mode=..." every time.
#
# Usage:
#   1. Edit the values below for this run (changing cluster_name is mandatory).
#   2. Run: ansible-playbook site.yml -e @.secrets-test -e @deploy-config.yml
#
# Secrets (vault_*) are NOT in this file — they stay in .secrets-test (test) or
# group_vars/all/vault.yml (production, encrypted with ansible-vault). See README.md's
# "How to run it" step 4 if you need to fill in a secret.
#
# Ansible's precedence order: -e (command line) > vars_files (vars/*.yml) > group_vars/all/vars.yml.
# This file is passed via -e, so it overrides every default in group_vars/all/vars.yml and vars/cluster.yml.
---

# ============================================================
# MANDATORY — no default; site.yml fails at preflight if left blank
# ============================================================
cluster_name: "k8s-demo"   # Cluster name: used for VM naming (k8s-demo-cp-01...), the Ceph pool name, and the Rancher tag.

# ============================================================
# RUN MODE
# ============================================================
mode: "new_cluster"          # new_cluster = build a brand-new cluster from scratch (runs the full 01→12)
                             # add_node    = only add a node to an existing cluster (01→02→03→04→07, skips Rancher/Ceph/Monitoring/Logging)

# ============================================================
# CHOOSE A RANCHER SERVER — the lab can have MULTIPLE Rancher instances (each managing a different
# group of clusters/tasks). How to pick one depends on rancher_mode:
# ============================================================
rancher_mode: "use_existing" # use_existing = use an ALREADY EXISTING Rancher server, picked via rancher_instance below
                             # install_new  = play 05 creates a NEW Rancher instance during this very run (read the comment block below carefully)

# --- Only used when rancher_mode=use_existing ---
rancher_instance: "main"    # Must match a key in `rancher_instances` (group_vars/all/vars.yml).
                            # To use a DIFFERENT Rancher (e.g. running several for different tasks):
                            # change the name here — no need to hand-edit any URL/token each time. If
                            # the name doesn't exist yet, add a new entry to `rancher_instances`
                            # (group_vars/all/vars.yml, URL only — not a secret) plus the matching
                            # real token under `vault_rancher_instances.<name>.api_token`
                            # (vault.yml/.secrets-test).

# --- Only relevant when rancher_mode=install_new — READ CAREFULLY before enabling ---
# install_new automatically installs K3s + Helm + cert-manager + Rancher on a NEW VM cloned as part
# of THIS SAME cluster_nodes list below (needs an extra { role: "rancher", ... } node), then logs in
# and uses that token for the rest of this run. What to fill in, and where:
#   - Node: add { role: "rancher", ram: 8192, cpu: 4, disk: 50 } to `cluster_nodes` below
#     (uncomment the NODE LIST section) — without this node, play 05 fails immediately at preflight.
#   - To pin this Rancher to one specific Proxmox node (instead of auto-select): add
#     `target_node: "proxmox-X"` to that item — e.g. always place Rancher on proxmox-1 while the
#     CP/worker cluster still auto-picks the least-busy node. See the comment in vars/cluster.yml.
#   - Password: `vault_rancher_bootstrap_password` (.secrets-test/vault.yml) — THIS IS THE ADMIN
#     PASSWORD FOR THE NEW RANCHER, nothing else. The lab defaults to a placeholder.
#   - Username: nothing to fill in — Rancher's bootstrap user is always "admin" (fixed, can't be
#     changed), and playbook 05 logs in with that username automatically.
#   - Permissions/token: play 05 creates its own token via the API login (not a hand-created API Key
#     like README step 3) — this token has full access on that NEW Rancher instance specifically
#     (equivalent to No Scope), enough to create/join a cluster during this same run.
#   - rancher_instance/rancher_instances above do NOT apply to the install_new path — the newly
#     created Rancher is ephemeral (only exists in this run's variables) and is NOT automatically
#     added to `rancher_instances`. To reuse it on a later run (rancher_mode=use_existing): after
#     play 05 finishes, manually add a new entry to `rancher_instances`
#     (group_vars/all/vars.yml) with a URL like `https://rancher.<new-rancher-VM-IP>.sslip.io`, and
#     add a real token (from the new Rancher's UI → Account & API Keys, same as README step 3) under
#     `vault_rancher_instances.<new-name>`.
# vault_rancher_bootstrap_password: "changeme"   # (set this in .secrets-test/vault.yml, NOT here)

# ============================================================
# CHOOSE A DATA-COLLECTOR HUB — the lab can have MULTIPLE hubs (each serving a different group of
# tasks/projects). Plays 09/10 ship this cluster's metrics/logs to EXACTLY ONE hub, chosen here.
# ============================================================
hub_instance: "default"    # Must match a key in `hub_instances` (vars/hub.yml). To send this
                           # cluster's data to a DIFFERENT hub: change the name here. If the name
                           # doesn't exist yet, add a new entry to `hub_instances` (vars/hub.yml,
                           # host/port only — not a secret) plus the matching real password under
                           # `vault_hub_instances.<name>.es_password` (vault.yml/.secrets-test).
                           # NOTE: this repo does NOT create a new hub automatically (the
                           # data-collector hub is still built by hand — see
                           # docs/08-observability-hub.md) — the hub must already exist.

# ============================================================
# CHOOSE WHICH PLAYBOOKS RUN — ONE MECHANISM, 2 WAYS TO EXPRESS IT. The stage_NN_* variable names
# carry the play's own number (NN) directly, so run_only (numbers) and the individual overrides
# (names) always agree — no separate number↔name lookup table needed, the number is already baked
# into the variable name. Execution order is ALWAYS the fixed 01→12 (site.yml) — both mechanisms
# below only toggle plays on/off, they can NEVER reorder them (01→12 is a real dependency chain, not
# an independent list: listing [11, 3, 1] or [1, 3, 11] produces the exact same result).
#
# Play 02 (discover-ips) and 05 (rancher-setup) have no stage_NN_* and aren't part of run_only —
# 02 always runs (almost every later play needs its discovered IPs), 05 is gated separately on rancher_mode above.
#
# Option A — numbers (concise, recommended): list exactly the playbooks you want to run.
run_only: []   # example: [1, 3, 11] — only runs play 01, 03 (+ 02 always tags along), and 11; empty = unrestricted

# Option B — individual named toggles (more granular, for overriding one or two specific plays
# without retyping the whole run_only list). Uncomment whichever line needs to change. ⚠️ If BOTH
# mechanisms are used at once: a value typed directly here ALWAYS wins over the value run_only would
# otherwise compute (both flow through the same -e, and an explicit value beats a derived one) — this
# is meant for overriding a single play on top of a run_only baseline, not a bug.
# stage_01_create_vms: true    # play 01 — clone VMs
# stage_03_storage_nic: true   # play 03 — storage VLAN + netplan
# stage_04_prep: true          # play 04 — OS cleanup, disk, sysctl
# stage_06_manifests: true     # play 06 — stage Calico/CoreDNS manifests BEFORE joining (new_cluster only)
# stage_07_join: true          # play 07 — join the cluster via the Rancher API (the highest-risk, most-reviewed area)
# stage_08_ceph_csi: true      # play 08 — Ceph CSI RBD (new_cluster only)
# stage_09_monitoring: true    # play 09 — node-exporter/kube-state-metrics/vmagent, remote_write to hub_instance (new_cluster only)
# stage_10_logging: true       # play 10 — Fluent Bit, forwards logs to hub_instance (new_cluster only)
# stage_11_gitlab_harbor: true # play 11 — GitLab/Harbor (TODO skeleton, harmless if enabled)
# stage_12_verify: true        # play 12 — verify the whole cluster, fails loud

# ============================================================
# NODE LIST — left as a comment = uses the default 2-node template (1 cp + 1 worker) from
# vars/cluster.yml. Uncomment + edit if this cluster needs a different configuration (node
# count/RAM/CPU/disk). role: cp|worker (|rancher when rancher_mode=install_new — see the install_new
# comment block above), type: general (kept for schema compatibility — there's no longer a special
# "monitoring" value; the monitoring/logging agents run fine on any node, no pinning needed).
#
# template_id/storage_id (OPTIONAL, declared per item) — omit to use the global default
# proxmox_template_id/proxmox_vm_storage (vars/proxmox.yml). Run ansible-discover/discover.yml FIRST
# to see the real list of templates/pools currently on Proxmox (vmid, name, node, notes/description
# — no need to dig through the Proxmox UI) before filling in exact numbers here.
#
# pin_static_ip (OPTIONAL, defaults to false) — true makes play 02b convert the DHCP IP to static
# (same IP, DHCP client just disabled) for a VM that needs a permanently stable IP
# (Rancher/data-collector hub — see playbooks/02b-pin-static-ip.yml for the root cause this solves).
# ONLY enable it for a "rancher" role VM (install_new) or a hub (playbooks/13-data-collector-hub.yml)
# — never for regular CP/worker K8s nodes.
# ⚠️ Read the warning at the top of playbooks/02b-pin-static-ip.yml carefully before enabling it (the
# residual risk of the DHCP server reassigning this same IP elsewhere unless it's excluded at the
# DHCP-server layer, which is outside Ansible's scope).
# ============================================================
# A real historical example, kept for reference: the default vars/cluster.yml sizing (cp:5120/
# worker:4096, 9216MB total) once didn't fit on any available node (after the 15% buffer) — the
# least-busy node only had ~9.41GB, about 245MB short. The worker was trimmed to 3584MB (8704MB
# total, leaving a ~280MB safety margin) — ONLY the worker was reduced; cp stayed at 5120 (that size
# fixed a real "No route to host" bug caused by a DHCP lease being lost during RKE2 bootstrap —
# lowering it again would have reintroduced that bug).
# Manually pinning nodes was also needed at one point: with nothing pinned, auto-select piles every
# VM onto the SAME node (best_node), so it needs one node with enough RAM for the ENTIRE 8704MB total
# at once — and when the two least-loaded nodes were already overcommitted elsewhere, no single node
# had room for both VMs together. Splitting them across two different pinned nodes solved it without
# reducing RAM further. Once more headroom frees up, these two target_node lines can be removed to
# fall back to auto-select.
cluster_nodes:
  - { role: "cp",     ram: 5120, cpu: 4, disk: 40, type: "general", target_node: "proxmox-4" }
  - { role: "worker", ram: 3584, cpu: 2, disk: 40, type: "general", target_node: "proxmox-3" }
#   # - { role: "worker", ram: 4096, cpu: 2, disk: 40, type: "general", template_id: 102, storage_id: "data2" }  # example: this VM clones from a DIFFERENT template + a different pool
#   # - { role: "rancher", ram: 8192, cpu: 4, disk: 50, target_node: "proxmox-1", pin_static_ip: true }   # only add this when rancher_mode=install_new; target_node is optional (see vars/cluster.yml)

# ============================================================
# CLUSTER TEARDOWN (only cleanup.yml reads this field, site.yml ignores it)
# ============================================================
# confirm_destroy: "yes"   # uncomment + set cluster_name above when you actually mean to run cleanup.yml

# ============================================================
# CREATING A NEW DATA-COLLECTOR HUB (playbooks/13-data-collector-hub.yml) — only used when a
# 2nd/3rd/... hub is needed for a different project. The existing hub (hub_instances.default) is
# still built by hand and untouched by this. Two separate commands (not part of the default
# site.yml run, and this file isn't passed directly to them — it's only a reference for the values,
# type the matching -e flags for real):
#
#   ansible-playbook site.yml -e @.secrets-test -e "cluster_name=hub-project-x" \
#     -e 'cluster_nodes=[{role:"cp",ram:16384,cpu:16,disk:150,type:"general",target_node:"proxmox-2",pin_static_ip:true}]' \
#     -e "run_only=[1,3,4,7,8]"
#   # pin_static_ip:true — a hub NEEDS a permanently stable IP (an IP change after a reboot breaks
#   # etcd's bind address and takes the whole node down). See the warning at the top of
#   # playbooks/02b-pin-static-ip.yml.
#
#   ansible-playbook -i inventories/production/hosts.ini -i .hosts_hub-project-x.ini \
#     playbooks/13-data-collector-hub.yml -e @.secrets-test -e "cluster_name=hub-project-x" \
#     -e "new_hub_es_password=<real password>" -e "new_hub_grafana_password=<real password>"
#
# target_node must be pinned manually (no auto-select) — pick a node that ISN'T already running
# another Rancher/hub (check the target_node field already recorded for each instance in
# rancher_instances/hub_instances, group_vars/all/vars.yml + vars/hub.yml, to see what's "busy").
# Once it's up: see the instructions for registering a new hub at the bottom of
# playbooks/13-data-collector-hub.yml.
# ============================================================
